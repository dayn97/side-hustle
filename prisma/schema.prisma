generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  AUTHOR
  ADMIN
}
enum ArticleStatus {
  DRAFT
  PUBLISHED
}
enum OrderType {
  MEMBERSHIP
  DONATION
}
enum PaymentProvider {
  STRIPE
  PAYPAL
  USDT
  DEMO
}
enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  isMember     Boolean  @default(false)
  memberUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  articles     Article[]
  orders       Order[]
}
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}
model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  titleZh     String
  titleEn     String
  excerptZh   String?
  excerptEn   String?
  contentZh   String
  contentEn   String
  coverUrl    String?
  category    String?
  tags        String[]
  tagsEn      String[]      @default([])
  isPremium   Boolean       @default(false)
  status      ArticleStatus @default(DRAFT)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status, createdAt])
  @@index([category])
}
model Order {
  id              String          @id @default(cuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            OrderType
  provider        PaymentProvider
  providerOrderId String?
  amount          Int
  currency        String          @default("USD")
  status          OrderStatus     @default(PENDING)
  idempotencyKey  String          @unique
  metadata        Json?
  createdAt       DateTime        @default(now())
  paidAt          DateTime?
  @@index([userId, createdAt])
  @@index([provider, providerOrderId])
}
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  receivedAt DateTime @default(now())
  payload    Json
  @@unique([provider, eventId])
}
