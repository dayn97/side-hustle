DATABASE_URL="postgresql://inkwell:inkwell@localhost:5432/inkwell?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth Web application. Production callback must match exactly:
# https://www.hustlovis.com/api/auth/google/callback
# Local callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional for local demo mode)
