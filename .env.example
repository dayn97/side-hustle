STRIPE_WEBHOOK_SECRET=""

# PayPal (optional for local demo mode)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# S3 / Cloudflare R2 (optional; article images accept external URLs in V1)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# USDT reserved for a future chain-confirmation adapter
